<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
        xmlns:views="clr-namespace:FileOrganizer.Views"
        xmlns:vm="clr-namespace:FileOrganizer.ViewModels"
        Width="700"
        Height="600"
        x:Class="FileOrganizer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://FileOrganizer/Assets/wolf.ico"
        Title="File organizer"
        Background="{DynamicResource WindowBgBrush}"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel>


        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Load settings..."
                          InputGesture="Ctrl+O"
                          HotKey="Ctrl+O"
                          Command="{Binding LoadSettingsCommand}" />
                <MenuItem Header="_Save settings"
                          InputGesture="Ctrl+S"
                          HotKey="Ctrl+S"
                          Command="{Binding ManualSaveCommand}" />
                <MenuItem Header="_Save settings as..."
                          InputGesture="Ctrl+Shift+S"
                          HotKey="Ctrl+Shift+S"
                          Command="{Binding SaveSettingsAsCommand}" />
                <MenuItem Header="Reset to defaults"
                          Command="{Binding ResetDefaultsCommand}" />
                <MenuItem Header="Show History"
                          Command="{Binding OpenHistoryCommand}" />
                <MenuItem Header="_Quit"
                          InputGesture="Ctrl+Q"
                          HotKey="Ctrl+Q"
                          Command="{Binding QuitCommand}" />
            </MenuItem>


            <MenuItem Header="Edit">
                <MenuItem Header="Undo"
                          InputGesture="Ctrl+Z"
                          HotKey="Ctrl+Z"
                          Command="{Binding UndoCommand}" />
            </MenuItem>


            <MenuItem Header="View">
                <MenuItem Header="Themes"
                          Command="{Binding OpenThemesCommand}">
                </MenuItem>
            </MenuItem>


            <MenuItem Header="Help">
                <MenuItem Header="Open github page"
                          Command="{Binding OpenGithubUrlCommand}" />
                <MenuItem Header="_About"
                          InputGesture="F1"
                          HotKey="F1"
                          Command="{Binding OpenAboutCommand}" />
            </MenuItem>
        </Menu>


        <Grid>


            <Border Background="{DynamicResource MenuBgBrush}"
                    Height="30.5"
                    VerticalAlignment="Top"
                    BorderBrush="{DynamicResource BorderMainBrush}"
                    BorderThickness="0,0,0,1" />
            <TabControl>
                <TabItem Header="Home"
                         FontSize="12">
                    <views:HomeView x:Name="HomeViewControl" DataContext="{Binding Home}" />
                </TabItem>


                <TabItem Header="Settings" FontSize="12">
                    <views:SettingsView x:Name="SettingsViewControl" DataContext="{Binding Settings}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>