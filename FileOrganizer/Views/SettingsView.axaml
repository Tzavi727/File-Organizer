<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FileOrganizer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="FileOrganizer.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Border Margin="10"
                    Padding="15"
                    BorderBrush="{DynamicResource BorderMainBrush}"
                    BorderThickness="1">
                <ListBox Background="{DynamicResource WindowBgBrush}"
                         BorderThickness="1"
                         ItemsSource="{Binding RulesList}"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*, Auto, *">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Key}"
                                           FontSize="16"
                                           HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1"
                                           Text=" ➔ "
                                           FontSize="16"
                                           Margin="10,0" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Value}"
                                           FontSize="16"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <TextBlock Text="System Rules"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Background="{DynamicResource WindowBgBrush}"
                       Margin="15, 3, 0, 0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top">
            </TextBlock>
            <TextBlock Text="Active Mapping"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Background="{DynamicResource WindowBgBrush}"
                       Margin="35, 19, 0, 0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top">
            </TextBlock>
        </Grid>


        <Grid Grid.Row="1">
            <Border Margin="10"
                    Padding="15"
                    BorderBrush="{DynamicResource BorderMainBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,auto,*">
                        <Grid Grid.Column="0" ColumnDefinitions="*,*">
                            <TextBox Grid.Column="0"
                                     Text="{Binding KeyToAdd, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="Extension"
                                     Margin="5"
                                     HorizontalAlignment="Stretch"
                                     Classes.HasText="{Binding HasKeyToAddText}">
                            </TextBox>
                            <TextBox Grid.Column="1"
                                     Text="{Binding ValueToAdd, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="Folder Name"
                                     Margin="5"
                                     HorizontalAlignment="Stretch"
                                     Classes.HasText="{Binding HasValueToAddText}">
                            </TextBox>
                        </Grid>
                        <Rectangle Grid.Column="1"
                                   Width="1"
                                   Fill="{DynamicResource BorderMainBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Stretch"
                                   Margin="15, -15">
                        </Rectangle>
                        <TextBox Grid.Column="2"
                                 Text="{Binding KeyToRemove, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="Extension to Delete."
                                 Margin="5"
                                 HorizontalAlignment="Stretch"
                                 Classes.HasText="{Binding HasKeyToRemoveText}">
                        </TextBox>
                    </Grid>
                    <Grid ColumnDefinitions="*,auto,*">
                        <Button Grid.Column="0"
                                Content="Add Extension"
                                FontSize="15"
                                Height="50"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Margin="5"
                                Command="{Binding AddRuleCommand}">
                        </Button>
                        <Rectangle Grid.Column="1"
                                   Width="1"
                                   Fill="{DynamicResource BorderMainBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Stretch"
                                   Margin="15, -15">
                        </Rectangle>
                        <Button Grid.Column="2"
                                Content="Remove Extension"
                                FontSize="15"
                                Height="50"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Margin="5"
                                Command="{Binding RemoveRuleCommand}">
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="Rule Management"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Background="{DynamicResource WindowBgBrush}"
                       Margin="20, 3, 0, 0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top">
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>