<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="400"
        x:Class="FileOrganizer.ThemesPreviews"
        Width="600"
        Height="500"
        Title="ThemesPreviews"
        Background="{DynamicResource WindowBgBrush}"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="10"
                Padding="5"
                BorderBrush="{DynamicResource BorderMainBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                         Name="ThemeList"
                         Margin="10"
                         Padding="0,0,0,0"
                         BorderBrush="{DynamicResource BorderMainBrush}"
                         FontSize="15"
                         SelectionChanged="ThemeList_SelectionChanged">

                    <ListBoxItem Content="Light" Tag="LightPreview.jpeg"/>
                    <ListBoxItem Content="Dark" Tag="DarkPreview.jpeg"/>

                </ListBox>

                <Border Grid.Column="1"
                        Margin="10"
                        Padding="15"
                        BorderBrush="{DynamicResource BorderMainBrush}"
                        BorderThickness="1">

                    <Image Name="ThemePreview"
                           Stretch="Fill"/>

                </Border>
                <TextBlock Text="Themes Previews"
                           Margin="0,-13,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Background="{DynamicResource WindowBgBrush}"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Padding="10"
                BorderBrush="{DynamicResource BorderMainBrush}"
                BorderThickness="1">

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="20">

                <Button Content="Save"
                        Width="80"
                        Click="SaveTheme_Click"/>
                <Button Content="OK"
                        Width="80"
                        Click="OK_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
