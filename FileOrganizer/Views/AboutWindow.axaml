<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="350"
		x:Class="FileOrganizer.AboutWindow"
		Title="About File Organizer"
		Width="450" Height="350" CanResize="False" WindowStartupLocation="CenterOwner">

	<Grid>
		<Border Background="{DynamicResource MenuBgBrush}"
				Height="27"
				VerticalAlignment="Top"
				BorderBrush="{DynamicResource BorderMainBrush}"
				BorderThickness="0,0,0,1"
				Margin="0,2,0,0"/>
		<TabControl>

			<TabItem Header="About">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="10">

					<Image Source="/Assets/wolf.png" Width="180"/>

					<TextBlock Text="File Organizer"
							   FontWeight="Bold"
							   FontSize="16"
							   HorizontalAlignment="Center"/>

					<TextBlock Text="Open Source, cross-platform file organizer"/>

					<TextBlock Text="File Organizer github repository"
							   HorizontalAlignment="Center"
							   Foreground="Blue"
							   Cursor="Hand"
							   TextDecorations="Underline"
							   PointerPressed="OpenGithubRepository"/>
					<TextBlock Text="Made By Tzavi" HorizontalAlignment="Center"/>
				</StackPanel>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
